\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Schematic representation of the third postulate: in a differentiable manifold we can always pass from one coordinate chart to another.}}{22}{figure.caption.4}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces On the left there is the first chart $\phi _1$, which covers almost all of the circumference except a point $p$, and on the right there is the other chart, which covers almost all of the circumference except a point $q$ diametrically opposite to $p$.}}{23}{figure.caption.5}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Each point on the sphere has a small neighbourhood which maps onto a disc in $\mathbb {R}^2$.}}{25}{figure.caption.6}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Representation of the traditional map from $S^2$ to $\mathbb {R}^2$. We can see that there are multivalued points which will not allow us to cover the manifold $S^2$ with a single chart.}}{26}{figure.caption.7}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Graphical representation used to find the stereographic projection of $S^2$ onto $\mathbb {R}^2$.}}{27}{figure.caption.8}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Schematic representation of the map $f$, which takes elements of the manifold and maps them onto the real line $\mathbb {R}$.}}{28}{figure.caption.9}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces The curve $\lambda $ maps an open interval of the reals into the manifold. On the manifold this map looks like (remember this is only a scheme) the kind of curve we are used to seeing, and at a point of that curve we can define a tangent vector $X_p$.}}{29}{figure.caption.10}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Two tangent vectors $X_p$ and $Y_p$, both tangent at $p$, living on two different curves $(\lambda _1,\lambda _2)$ but belonging to the same vector space $T_p(M)$.}}{30}{figure.caption.11}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Graphical representation of the relative movement between the two test bodies.}}{59}{figure.caption.13}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces In the left there are two particles which are in a free fall to the earth an the inertial reference frame (IRF) is to the side of the earth, he observes a diagonal trajectory of the bodies. In the right we set the IRF inside the box with the two bodies, and he observes that there is a strange force which makes the bodies get together.}}{61}{figure.caption.14}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces In the left there is a light ray seeing from an inertial reference frame inside the box, and in the right there is the same ray but seeing from the earth.}}{62}{figure.caption.15}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Space-time diagram representation for the Doppler effect analized before.}}{64}{figure.caption.16}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces The light cone for the space-time structure, in the $x$-axis there is $\mathbb {R}^3$ and in the $y$ axis there is the coordinate time $t$, a space-like vector is a vector which lives outwards the cone, a light-like lives on the border of the cone and a time-like lives inside the cone.}}{68}{figure.caption.17}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Graphical representation of an integral time-like curve on a manifold $M$.}}{69}{figure.caption.18}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces The real time-like trajectory a particle will follow is $\lambda (\tau )$ and the other two will be little different trajectories but with initial an final points fixed.}}{70}{figure.caption.19}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Affine parameterization of the geodesics, here we illustrate the path (geodesic) a free particle will follow which is parameterized with a parameter $t$ but this is some application of the other parameter $u$.}}{86}{figure.caption.20}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Connection between $q$ and $p$ with a curve along a variation of $s$ with $X$ as tangent vector, in the same way $q$ and $r$ can be connected by a curve with $Y$ as tangent vector, $p$ and $u$ can be connected with a curve with $Y$ as tangent vector and same with $u$ and $r$ but with $X$ as tangent vector.}}{90}{figure.caption.21}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Representation of all the possible subsets of $S$ constant and $t$ constant, this is an analogous to what is done in the formulation $3+1$ where we separate the space-time and folds as a Cauchy space. }}{99}{figure.caption.22}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces Representation of the region (manifold $M$) of integration and its surrounding surface$\Sigma M$.}}{109}{figure.caption.23}%
