\contentsline {figure}{\numberline {2.1}{\ignorespaces Esquema experimental del estudio efectuado por Alan Aspect, Philippe Grangier y Gérard Roger en 1986.}}{40}{figure.caption.13}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Campo eléctrico en todos sus modos confinado en una cavidad con paredes conductoras perfectas}}{42}{figure.caption.14}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Se representan gráficamente los primeros 6 niveles de energía para un oscilador harmónico cuántico, en este caso correspondiente al hamiltoniano del campo electromagnético. Para los niveles de energía; $1,3,6$ se ilustran estos estados en la base de posición, los cuales corresponden a las funciones de Hermite-Gauss.}}{54}{figure.caption.15}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Los estados coherentes oscilan armónicamente a lo largo del potencial entre los puntos de retorno clásicos. Debido a la forma de estos estados, que sus autovalores con el operador de aniquilación correspondan a una representación compleja de los valores medios de los operadores cuadratura apunta a que físicamente estos estados representan la oscilación bien dirigida de la energía de la radiación.}}{55}{figure.caption.16}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Densidad de probabilidad para los estados número coherentes.}}{56}{figure.caption.17}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Distribución de fase para los estados coherentes, en los cuales se ilustran dos estados centrados en el origen y con dos valores medios del número de cuantos de energía distintos.}}{57}{figure.caption.18}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Representación esquemática sobre el plano complejo $\mathbb {C}^2$ en el cual se ve el efecto del exponencial de $e^{i\hat {\phi }}$ y su adjunto conjugado $e^{i\hat {\phi }}$.}}{60}{figure.caption.19}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Relación entre el operador de ángulo restringido $\hat {\phi }$ con $-\pi < \hat {\phi } \leq \pi $ y el operador de ángulo $\hat {\chi }$.}}{62}{figure.caption.20}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Effecto de la TFF sobre la distribución de Wigner en el espacio de fase de los estados coherentes $\mathinner {|{\alpha }\rangle }$.}}{71}{figure.caption.21}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Representación gráfica de los estados de fase como la rotación de los estados numeral $\mathinner {|{\#}\rangle }$}}{72}{figure.caption.22}%
