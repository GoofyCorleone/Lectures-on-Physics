\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces Representación de las funciones de Green para fuentes puntuales. Bajo estas condiciones de frontera, las funciones de Green se comportan como cargas puntuales, una imagen especular de la otra.}}{15}{figure.caption.4}\protected@file@percent }
\newlabel{fig:greenpoint}{{1.2}{15}{Representación de las funciones de Green para fuentes puntuales. Bajo estas condiciones de frontera, las funciones de Green se comportan como cargas puntuales, una imagen especular de la otra}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Representación de las funciones de Green para fuentes no puntuales. Bajo estas condiciones de frontera, las funciones de Green siguen comportándose como imágenes especulares, pero ahora con un volumen y una geometría dados; la única restricción sobre la emisión de estas fuentes es que, en la frontera $z=0$, el campo total debe anularse, como exigen las condiciones de Dirichlet supuestas.}}{16}{figure.caption.5}\protected@file@percent }
\newlabel{fig:greennonpoint}{{1.3}{16}{Representación de las funciones de Green para fuentes no puntuales. Bajo estas condiciones de frontera, las funciones de Green siguen comportándose como imágenes especulares, pero ahora con un volumen y una geometría dados; la única restricción sobre la emisión de estas fuentes es que, en la frontera $z=0$, el campo total debe anularse, como exigen las condiciones de Dirichlet supuestas}{figure.caption.5}{}}
