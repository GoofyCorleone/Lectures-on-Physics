\contentsline {figure}{\numberline {2.7}{\ignorespaces Representation of all the incident and refracted rays from a media with refraction index $n_1$ to another with refraction index $n_2$ such that $n_1>n_2$. The angle $\theta _2$ here shown wont never reach a value equal to $asin\left (\frac {n_1}{n_2}\right )$.}}{27}{figure.caption.9}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Representation of all the incident and refracted rays from a media with refraction index $n_1$ to another with refraction index $n_2$ such that $n_1<n_2$. The angle $\theta _c$ here separates the rays that will be refracted , (angles less than $\theta _c$), and the rays that will be totally reflected internally.}}{28}{figure.caption.10}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Representation of two optical systems where appear real object points, real and virtual image points.}}{29}{figure.caption.11}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Optical system $\mathcal {S}$ formed by two diopters $\mathcal {S}_1,\mathcal {S}_2$ where the point $A_o$ is a virtual object and $A_i$ is a virtual image point.}}{29}{figure.caption.12}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Optical system $\mathcal {S}$ formed by three optical systems $\mathcal {S}_1,\mathcal {S}_2,\mathcal {S}_3$ where the point $A_o$ is a real object point, $A'$ is a virtual image point for $\mathcal {S}_1$, but a real object point for $\mathcal {S}_2,\mathcal {S}_3$, $A''$ is a virtual image for the real object $A'$ and $A_i$ is the real image of the virtual object $A''$.}}{30}{figure.caption.13}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces The stigmatic system transform the incident wavefront $\mathcal {A}$ to another new spherical wavefront $\mathcal {A}'$.}}{31}{figure.caption.14}%
\contentsline {figure}{\numberline {2.13}{\ignorespaces Scheme representation of the development of a rigorously stigmatic system, from a point source $A_o$ at a position $[0,0,z_o]$ the diopter with a vertice $v$ forms a perfect image $A_i$ at $[0,0,z_i]$. }}{32}{figure.caption.15}%
