\contentsline {figure}{\numberline {6.1}{\ignorespaces Representation of $E(\vec {r},t)$ as a random variable.}}{72}{figure.caption.27}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Graphical representation of the narrowband coherence function. In black, the envelope $\tilde {\Gamma }(\vec {r},\tau )$ is shown, and in red the oscillations $e^{i2\pi \tilde {\nu }\tau }$. These oscillations are confined within something known as the coherence time $\tau _C$, which we shall see later.}}{77}{figure.caption.28}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Propagation of the electric field from a plane $Z=0$ to a plane $Z$, where each point of the wavefront carries its mean polarisation ellipse.}}{79}{figure.caption.29}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Propagation of the coherence function between two points $\vec {r},\vec {r}'$ on the initial plane to the coherence between two points $\vec {r}_1,\vec {r}_2$ on the observation plane.}}{80}{figure.caption.30}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Evolution of the realisations upon propagating the electric field.}}{82}{figure.caption.31}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces The mutual coherence propagated to the far field is the Fourier transform of the intensity distribution $\Gamma _0(\vec {S})$ of the source.}}{84}{figure.caption.32}%
