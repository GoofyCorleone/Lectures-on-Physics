\contentsline {figure}{\numberline {2.1}{\ignorespaces Schematic representation of the Fizeau's experiment pretended to measure the light's speed.}}{18}{figure.caption.3}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Graphical representation of a generic dark room which is a box of an arbitrary material which has a side opened and while it satisfies the Rayleigh's inequality i will form an inverted image.}}{20}{figure.caption.4}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces A schematic representation of a ray beam from $A$ to $B$ which goes through n different transparent media and in each one it had a different speed and traveled different length.}}{22}{figure.caption.5}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces two media separated by a diopter which an observer $O$ measures the path the light will follow from $A$ to $B$ and proposes a displacement of the source $A$ to $A'$ to see how must be the light path.}}{24}{figure.caption.6}%
