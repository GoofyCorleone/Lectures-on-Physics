\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Schematic representation of the Fizeau's experiment pretended to measure the light's speed.}}{18}{figure.caption.3}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Graphical representation of a generic dark room which is a box of an arbitrary material which has a side opened and while it satisfies the Rayleigh's inequality i will form an inverted image.}}{20}{figure.caption.4}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces A schematic representation of a ray beam from $A$ to $B$ which goes through n different transparent media and in each one it had a different speed and traveled different length.}}{22}{figure.caption.5}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces two media separated by a diopter which an observer $O$ measures the path the light will follow from $A$ to $B$ and proposes a displacement of the source $A$ to $A'$ to see how must be the light path.}}{24}{figure.caption.6}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Representation of a cylindrical ray light being reflected by a perfectly polished mirror.}}{26}{figure.caption.7}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Representation of a cylindrical bunch of rays being reflected by an inhomogeneus surface.}}{27}{figure.caption.8}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Representation of all the incident and refracted rays from a media with refraction index $n_1$ to another with refraction index $n_2$ such that $n_1>n_2$. The angle $\theta _2$ here shown wont never reach a value equal to $asin\left (\frac {n_1}{n_2}\right )$.}}{28}{figure.caption.9}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Representation of all the incident and refracted rays from a media with refraction index $n_1$ to another with refraction index $n_2$ such that $n_1<n_2$. The angle $\theta _c$ here separates the rays that will be refracted , (angles less than $\theta _c$), and the rays that will be totally reflected internally.}}{29}{figure.caption.10}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Representation of two optical systems where appear real object points, real and virtual image points.}}{30}{figure.caption.11}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Optical system $\mathcal {S}$ formed by two diopters $\mathcal {S}_1,\mathcal {S}_2$ where the point $A_o$ is a virtual object and $A_i$ is a virtual image point.}}{30}{figure.caption.12}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Optical system $\mathcal {S}$ formed by three optical systems $\mathcal {S}_1,\mathcal {S}_2,\mathcal {S}_3$ where the point $A_o$ is a real object point, $A'$ is a virtual image point for $\mathcal {S}_1$, but a real object point for $\mathcal {S}_2,\mathcal {S}_3$, $A''$ is a virtual image for the real object $A'$ and $A_i$ is the real image of the virtual object $A''$.}}{31}{figure.caption.13}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces The stigmatic system transform the incident wavefront $\mathcal {A}$ to another new spherical wavefront $\mathcal {A}'$.}}{32}{figure.caption.14}%
\contentsline {figure}{\numberline {2.13}{\ignorespaces Scheme representation of the development of a rigorously stigmatic system, from a point source $A_o$ at a position $[0,0,z_o]$ the diopter with a vertice $v$ forms a perfect image $A_i$ at $[0,0,z_i]$. }}{33}{figure.caption.15}%
\contentsline {figure}{\numberline {2.14}{\ignorespaces The spherical Diopter for the first case, where the object point is real and it is outside the sphere but the image point is virtual and inside the diopter.}}{38}{figure.caption.16}%
\contentsline {figure}{\numberline {2.15}{\ignorespaces Prolate Ellipsoid centered and $z=B$.}}{40}{figure.caption.17}%
\contentsline {figure}{\numberline {2.16}{\ignorespaces Ellipsoid diopter when $n_i > n_o$.}}{41}{figure.caption.18}%
\contentsline {figure}{\numberline {2.17}{\ignorespaces Ellipsoid diopter when $n_i>n_o$ and $z_i < 0$.}}{42}{figure.caption.19}%
\contentsline {figure}{\numberline {2.18}{\ignorespaces Geometrical representation of the two leaf hyperboloid with the parameters $a,b$ and foci $F_1$ and $F_2$.}}{43}{figure.caption.20}%
\contentsline {figure}{\numberline {2.19}{\ignorespaces Geometrical representation of the first case of a two leaf hyperboloid. }}{44}{figure.caption.21}%
\contentsline {figure}{\numberline {2.20}{\ignorespaces Geometrical representation of the first case of a two leaf hyperboloid.}}{45}{figure.caption.22}%
\contentsline {figure}{\numberline {2.21}{\ignorespaces Ellipsoidal mirror. The object $F_1$ and the image $F_2$ coincide with the two foci of the ellipse, so every ray leaving one focus is reflected exactly onto the other.}}{46}{figure.caption.23}%
\contentsline {figure}{\numberline {2.22}{\ignorespaces Hyperboloid mirror. The rays from the object $F_1$ diverge as they were emited by a virtual image locaed in $F_2$.}}{48}{figure.caption.24}%
\contentsline {figure}{\numberline {2.23}{\ignorespaces Parabolic mirror obtained as the limit $z_o\to -\infty $. The rays coming parallel to the axis from an object at infinity are all focused onto the single point $z=z_i$.}}{50}{figure.caption.25}%
\contentsline {figure}{\numberline {2.24}{\ignorespaces Rigorously stigmatic quartic surface described in the meridional plane by the polar parameters $\rho $ and $\varphi $ measured from the vertex $\mathcal {O}$. The object point $A_o$ at $z_o$ and the image point $A_i$ at $z_i$ are the strictly stigmatic pair, and at the incidence point $I$ the vectorial Snell-Descartes law $n_o\hat {u} - n_i\hat {u}' = \kappa \hat {N}$ is satisfied.}}{53}{figure.caption.26}%
\contentsline {figure}{\numberline {2.25}{\ignorespaces Meridional sections of Cartesian surfaces with the refraction indices fixed at $n_o=1$ and $n_i=1.7$ while the object and image positions are varied. The solid curves are the solutions with the minus sign in \ref {eq:SagBothSigns}, which pass through the origin and are the Descartes ovoids, and the dashed curves are the solutions with the plus sign, the outer sheet of the same quartic. (a) $z_o=-10$ and $z_i=20$. (b) $z_o=-10$ and $z_i=-20$. (c) $z_o=10$ and $z_i=20$. (d) $z_o=10$ and $z_i=-20$.}}{55}{figure.caption.27}%
\contentsline {figure}{\numberline {2.26}{\ignorespaces Degenerate cases of refractive and reflective rigorously stigmatic surfaces according to the refraction indices and the object and image positions. For each combination of these parameters the values of the shape parameters $GOTS$ of the corresponding conic of revolution are obtained. Note that $T=S=0$ in every conic case, and that the reflective surfaces are recovered by the substitution $n_i\to -n_o$.}}{56}{figure.caption.28}%
\contentsline {figure}{\numberline {2.27}{\ignorespaces Image formation by a spherical diopter $\mathcal {D}$ of radius $R$, vertex $V$ and centre of curvature $C$. The object $O$ is at a distance $d=z_o$ from the vertex and the image $O'$ at $d'=z_i$, and the ray reaches the surface at the point $I$, which is located by the angle $\varphi $ measured at the centre of curvature. The chord $\rho = \overline {VI}$, the transverse height $h$ and the sagitta $\eta $ are the three geometrical quantities that will organise the whole calculation.}}{61}{figure.caption.29}%
\contentsline {figure}{\numberline {2.28}{\ignorespaces Quartic surface $Q$ of the wavefront emerging from a spherical refracting surface. The marginal rays converge at $A'$ instead of the paraxial point $A_p$, because the quartic wavefront $Q$ departs from the Gaussian spherical reference $\mathcal {A}'$ by the amount $\Delta l = W(\vec {\rho })$, and the envelope of the refracted rays forms the caustic.}}{67}{figure.caption.30}%
\contentsline {figure}{\numberline {2.29}{\ignorespaces Illustration of the longitudinal spherical aberration. The rays arriving parallel to the axis from an object at infinity are focused at $f_{M_+}$ if they are marginal and at $f_{P_+}$ if they are paraxial, and the separation between the two is $\Delta f_+$. The envelope of the refracted rays is the caustic.}}{72}{figure.caption.31}%
\contentsline {figure}{\numberline {2.30}{\ignorespaces Illustration of the defocus in the object space. The rays that emerge parallel to the axis in the image space come, for the marginal zone, from $f_{M_-}$ and, for the paraxial zone, from $f_{P_-}$, and the separation between the two is $\Delta f_-$.}}{73}{figure.caption.32}%
\contentsline {figure}{\numberline {2.31}{\ignorespaces Image formation systems. Each family of rays alone forms a sharp image, and it is only their superposition that produces the aberrated one.}}{74}{figure.caption.33}%
\contentsline {figure}{\numberline {2.32}{\ignorespaces Thin lens with aberrations, formed by two spherical diopters of radii $R_1$ and $R_2$ separating the medium $n$ from the glass $n'$. The thickness $\Delta $ between the two vertices is taken to zero at the end of the calculation.}}{75}{figure.caption.34}%
\contentsline {figure}{\numberline {2.33}{\ignorespaces The aplanatism condition. Two pairs of rigorously stigmatic points $(A_1,A_1')$ and $(A_2,A_2')$ are considered, with $A_1'$ in a neighbourhood of $A_1$ and $A_2'$ in a neighbourhood of $A_2$, the diopter $D$ separating the media $n_1$ and $n_2$, and $\Delta \vec {I}$ being the displacement of the incidence point on the surface. The Spanish label \textit {vecindad} in the figure means neighbourhood.}}{77}{figure.caption.35}%
\contentsline {figure}{\numberline {2.34}{\ignorespaces Geometry of the Abbe sine condition. The transverse object $\overline {A_1A_1'}$ in the medium $n_1$ is imaged as $\overline {A_2A_2'}$ in the medium $n_2$, and $\theta _1$ and $\theta _2$ are the angles that a given ray makes with the axis in the object and image spaces.}}{79}{figure.caption.36}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces A source $\mathcal {S}$ produces an arbitrary kind of wave which propagates in the space-time, then, for any given time and position we can take an arbitrary point $p$ and, due to the smooth manifold nature of this wave, there exists a neighborhood $N$ of $p$ where the wavefront is plane.}}{96}{figure.caption.37}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces The polarisation ellipse can be reconstructred taking all the possible rotations of the two phasors (which corresponds to the compoenentes of the Jones spinor).}}{99}{figure.caption.38}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces The general form of the polarisation ellipse can be described with only two angles; the orientation angle $\alpha $ and the elipticity angle $\chi $. }}{100}{figure.caption.39}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces The polarisation ellipse is completely unrotated due to the relative phases between the componentes of the electric field. }}{101}{figure.caption.40}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces In the Poincaré any polarisation state is a point on the surface on the sphere, howerver if the state is partially polarized it would be a pointe inside the poincaré sphere whose distance from the center is $\sqrt {S_1^2+S_2^2 + S_3^2}$.}}{111}{figure.caption.41}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces The stereographic projection. A ray leaving the centre of projection $N$ and passing through a point $P$ of the sphere $S^2$ meets the plane $\mathbb {R}^2$ at a single point $Q$. Points near the contact point fall near the origin, and points near $N$ fly off towards infinity.}}{114}{figure.caption.42}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces The Poincaré sphere resting on the complex plane of the ratio $w$. Horizontal polarisation sits at the point of contact, $w=0$, vertical polarisation sits at the centre of projection and is sent to the point at infinity, and the equator, where the two amplitudes are equal, is mapped onto the unit circle $|w|=1$. The angles $2\alpha $ and $2\chi $ that locate a state $P$ on the sphere are twice the orientation and ellipticity angles of its ellipse.}}{116}{figure.caption.43}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces The flattened Poincaré sphere. Each point of the complex plane of $w$ carries the ellipse of the state it represents. The origin is horizontal polarisation, the real axis carries every linear state, the imaginary axis carries the ellipses aligned with the coordinate axes together with the two circular states, and every direction of escape to infinity leads to one and the same state, the vertical one.}}{118}{figure.caption.44}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces A quarter wave plate retarder is a retarder with $\delta = \pi /2$ and when it has got its fast axis oriented with the horizontal one it transforms the polarization in a very specific way. The $\pm 45$° diagonal states transform into circular polarization states, and the circular polarization states transform into $\pm 45$° diagonal states. }}{120}{figure.caption.45}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces A linear polariser with its polariser axis oriented parallel to the horizontal axis proyects all the incident states to horizontal ones, however the transmited intensity is reduced by the relative angle between the incident state $\mathinner {|{\alpha ;\chi }\rangle }$ and the polariser axis $\alpha _{pol}$ in this case $\alpha _{pol}=0$°. }}{124}{figure.caption.46}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces An initial state $\mathinner {|{\alpha ;\chi }\rangle }$ under the effect of a rotated retarder with retar $\delta $ and eigenstate $r$ is rotated an angle of $\delta $ arounde the $r$-axis to a final state $\mathinner {|{\alpha '.\chi '}\rangle }$. }}{129}{figure.caption.47}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Two plane waves with unitary number vector $\hat {k}_1,\hat {k}_2$ propagate and interferece producing a pattern of interference characterized by a vector $\vec {K}$ and an interfringe distance $\Lambda $.}}{146}{figure.caption.48}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Two plane sources of spherical waves interfere in a point $P$ located on the interference plane. The two sources are separated a distance $a$ an the distance from both surface to the interference plane is $D$.}}{147}{figure.caption.49}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Young interferometer illuminated by a spherical wave from a point source $\mathcal {S}$ placed off axis. The source to slit stage sets the amplitude and the phase reaching each slit $\mathcal {S}_1,\mathcal {S}_2$, and the slit to screen stage is the interference of two secondary spherical waves.}}{153}{figure.caption.50}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Method of images applied to the Fresnel biprism. Each half of the biprism produces a virtual point image of the source, $\mathcal {S}_1$ from the upper half and $\mathcal {S}_2$ from the lower half, separated by $a$ and located in the same transverse plane as $\mathcal {S}$. Beyond the biprism the two beams overlap only inside the shaded strip of width $W$ on the screen.}}{157}{figure.caption.51}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces General configuration of the Michelson interferometer. A source placed a distance $a$ from the beamsplitting cube illuminates it, and the beam is divided along two perpendicular arms. In arm 1 the light travels a total distance $d+\ell _1$ before striking mirror 1, tilted an angle $\theta $ away from the orientation that would send the beam straight back along itself; in arm 2 it travels a total distance $d+\ell _2$ before striking mirror 2, tilted an angle $\phi $ in the same sense. The two reflected beams return to the beamsplitter and recombine there, ready to interfere.}}{161}{figure.caption.52}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Construction of the virtual source of the first arm. The source $\mathcal {S}$ is first reflected in the plane of the mirror $M_1$, giving $\mathcal {S}_1'$, and this image is then reflected in the plane of the beamsplitter, giving $\mathcal {S}_1$. In each step the segment joining a point to its image is perpendicular to the corresponding plane and is bisected by it, which is what the right angles and the equal marks record. The interferometer of figure \ref {fig:MichelsonInterferometer} is kept faded in the background so that the construction may be followed against the real geometry of the instrument.}}{166}{figure.caption.53}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Construction of the virtual source of the second arm. Here the order is reversed with respect to the first arm, since the light meets the beamsplitter before the mirror. The source is first reflected in the plane of the splitter, giving $\mathcal {S}_2'$ on the axis of the second arm at a distance $a$ below the origin, and this image is then reflected in the plane of the mirror $M_2$, giving $\mathcal {S}_2$.}}{167}{figure.caption.54}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces The interferometer completely solved by the method of images. The construction of both arms is superposed on the faded instrument, and the two resulting virtual sources $\mathcal {S}_1$ and $\mathcal {S}_2$ are shown with their position vectors measured from the origin $O$ at the centre of the beamsplitter, together with the separation $\vec {\Delta }$ that governs the interference. From the point of view of the output, the whole interferometer has been replaced by these two mutually coherent point sources.}}{169}{figure.caption.55}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces On the boundary $\Sigma (V)$ the contribution of the field components $U(\vec {r})$ is shown; inside the region the total field is built from the contribution of all the points on the boundary. One may add infinitely many point Green charges of arbitrary propagation nature; the condition for the invariance of equation \eqref {eq:GreenHomogeneous} is that these image charges lie outside $\Sigma (V)$.}}{182}{figure.caption.56}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Representation of the Green's functions for point sources. Under these boundary conditions the Green's functions behave as point charges, one the mirror image of the other.}}{183}{figure.caption.57}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Representation of the Green's functions for non-point sources. Under these boundary conditions the Green's functions still behave as mirror images, but now with given volume and geometry; the only constraint on the emission of these sources is that, on the boundary $z=0$, the total field must vanish, as required by the assumed Dirichlet conditions.}}{184}{figure.caption.58}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Geometry of the two confocal spheres. The cap $\mathcal {A}$ is tangent to the emitting plane $\mathcal {P}$ at the vertex $O$ and has its centre of curvature at $O'$, while the cap $\mathcal {F}$ is tangent to the receiving plane $\mathcal {Q}$ at $O'$ and has its centre of curvature at $O$, so that both radii equal the propagation distance $z$. Read on these two surfaces, the Fresnel propagation reduces to an exact Fourier transformation, which in the language of the fractional Fourier transformation of Section~\ref {sec:FrFT} is the order $\alpha = \pi /2$.}}{189}{figure.caption.59}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Scheme of the confocal cardinal spheres, with radii equal to the propagation distance $z$ of the field.}}{191}{figure.caption.60}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces The two cardinal spheres of radius $R$ associated with a propagation over the distance $z$. The emitting cap $\mathcal {A}$ is tangent to its plane at $V_{\mathcal {A}}$ with its centre of curvature downstream at $C_{\mathcal {A}}$, of abscissa $R$, and the receiving cap $\mathcal {B}$ is tangent to its plane at $V_{\mathcal {B}}$ with its centre upstream at $C_{\mathcal {B}}$, of abscissa $z-R$, so that the two caps bow towards each other. The quantity $\delta $ is the sagitta \eqref {eq:FrFT:Sagitta}. The confocal case of Figure~\ref {fig:ConfocalSpheres} is recovered when $R = z$, since then $C_{\mathcal {A}}$ falls on $V_{\mathcal {B}}$ and $C_{\mathcal {B}}$ on $V_{\mathcal {A}}$.}}{208}{figure.caption.61}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Representation of $E(\vec {r},t)$ as a random variable.}}{232}{figure.caption.62}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Graphical representation of the narrowband coherence function. In black, the envelope $\tilde {\Gamma }(\vec {r},\tau )$ is shown, and in red the oscillations $e^{i2\pi \tilde {\nu }\tau }$. These oscillations are confined within something known as the coherence time $\tau _C$, which we shall see later.}}{238}{figure.caption.63}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Propagation of the electric field from a plane $Z=0$ to a plane $Z$, where each point of the wavefront carries its mean polarisation ellipse.}}{240}{figure.caption.64}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Propagation of the coherence function between two points $\vec {r},\vec {r}'$ on the initial plane to the coherence between two points $\vec {r}_1,\vec {r}_2$ on the observation plane.}}{241}{figure.caption.65}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Evolution of the realisations upon propagating the electric field.}}{243}{figure.caption.66}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces The mutual coherence propagated to the far field is the Fourier transform of the intensity distribution $\Gamma _0(\vec {S})$ of the source.}}{245}{figure.caption.67}%
\contentsfinish 
