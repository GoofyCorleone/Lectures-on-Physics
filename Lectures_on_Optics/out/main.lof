\contentsline {figure}{\numberline {2.1}{\ignorespaces Schematic representation of the Fizeau's experiment pretended to measure the light's speed.}}{18}{figure.caption.3}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Graphical representation of a generic dark room which is a box of an arbitrary material which has a side opened and while it satisfies the Rayleigh's inequality i will form an inverted image.}}{20}{figure.caption.4}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces A schematic representation of a ray beam from $A$ to $B$ which goes through n different transparent media and in each one it had a different speed and traveled different length.}}{22}{figure.caption.5}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces two media separated by a diopter which an observer $O$ measures the path the light will follow from $A$ to $B$ and proposes a displacement of the source $A$ to $A'$ to see how must be the light path.}}{24}{figure.caption.6}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Representation of a cylindrical ray light being reflected by a perfectly polished mirror.}}{26}{figure.caption.7}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Representation of a cylindrical bunch of rays being reflected by an inhomogeneus surface.}}{27}{figure.caption.8}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Representation of all the incident and refracted rays from a media with refraction index $n_1$ to another with refraction index $n_2$ such that $n_1>n_2$. The angle $\theta _2$ here shown wont never reach a value equal to $asin\left (\frac {n_1}{n_2}\right )$.}}{28}{figure.caption.9}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Representation of all the incident and refracted rays from a media with refraction index $n_1$ to another with refraction index $n_2$ such that $n_1<n_2$. The angle $\theta _c$ here separates the rays that will be refracted , (angles less than $\theta _c$), and the rays that will be totally reflected internally.}}{29}{figure.caption.10}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Representation of two optical systems where appear real object points, real and virtual image points.}}{30}{figure.caption.11}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Optical system $\mathcal {S}$ formed by two diopters $\mathcal {S}_1,\mathcal {S}_2$ where the point $A_o$ is a virtual object and $A_i$ is a virtual image point.}}{30}{figure.caption.12}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Optical system $\mathcal {S}$ formed by three optical systems $\mathcal {S}_1,\mathcal {S}_2,\mathcal {S}_3$ where the point $A_o$ is a real object point, $A'$ is a virtual image point for $\mathcal {S}_1$, but a real object point for $\mathcal {S}_2,\mathcal {S}_3$, $A''$ is a virtual image for the real object $A'$ and $A_i$ is the real image of the virtual object $A''$.}}{31}{figure.caption.13}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces The stigmatic system transform the incident wavefront $\mathcal {A}$ to another new spherical wavefront $\mathcal {A}'$.}}{32}{figure.caption.14}%
\contentsline {figure}{\numberline {2.13}{\ignorespaces Scheme representation of the development of a rigorously stigmatic system, from a point source $A_o$ at a position $[0,0,z_o]$ the diopter with a vertice $v$ forms a perfect image $A_i$ at $[0,0,z_i]$. }}{33}{figure.caption.15}%
\contentsline {figure}{\numberline {2.14}{\ignorespaces The spherical Diopter for the first case, where the object point is real and it is outside the sphere but the image point is virtual and inside the diopter.}}{38}{figure.caption.16}%
\contentsline {figure}{\numberline {2.15}{\ignorespaces Prolate Ellipsoid centered and $z=B$.}}{40}{figure.caption.17}%
\contentsline {figure}{\numberline {2.16}{\ignorespaces Ellipsoid diopter when $n_i > n_o$.}}{41}{figure.caption.18}%
\contentsline {figure}{\numberline {2.17}{\ignorespaces Ellipsoid diopter when $n_i>n_o$ and $z_i < 0$.}}{42}{figure.caption.19}%
\contentsline {figure}{\numberline {2.18}{\ignorespaces Geometrical representation of the two leaf hyperboloid with the parameters $a,b$ and foci $F_1$ and $F_2$.}}{43}{figure.caption.20}%
\contentsline {figure}{\numberline {2.19}{\ignorespaces Geometrical representation of the first case of a two leaf hyperboloid. }}{44}{figure.caption.21}%
\contentsline {figure}{\numberline {2.20}{\ignorespaces Geometrical representation of the first case of a two leaf hyperboloid.}}{45}{figure.caption.22}%
\contentsline {figure}{\numberline {2.21}{\ignorespaces Ellipsoidal mirror. The object $F_1$ and the image $F_2$ coincide with the two foci of the ellipse, so every ray leaving one focus is reflected exactly onto the other.}}{46}{figure.caption.23}%
\contentsline {figure}{\numberline {2.22}{\ignorespaces Hyperboloid mirror. The rays from the object $F_1$ diverge as they were emited by a virtual image locaed in $F_2$.}}{48}{figure.caption.24}%
\contentsline {figure}{\numberline {2.23}{\ignorespaces Parabolic mirror obtained as the limit $z_o\to -\infty $. The rays coming parallel to the axis from an object at infinity are all focused onto the single point $z=z_i$.}}{50}{figure.caption.25}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces A source $\mathcal {S}$ produces an arbitrary kind of wave which propagates in the space-time, then, for any given time and position we can take an arbitrary point $p$ and, due to the smooth manifold nature of this wave, there exists a neighborhood $N$ of $p$ where the wavefront is plane.}}{66}{figure.caption.26}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces The polarisation ellipse can be reconstructred taking all the possible rotations of the two phasors (which corresponds to the compoenentes of the Jones spinor).}}{69}{figure.caption.28}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces The general form of the polarisation ellipse can be described with only two angles; the orientation angle $\alpha $ and the elipticity angle $\chi $. }}{70}{figure.caption.30}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces The polarisation ellipse is completely unrotated due to the relative phases between the componentes of the electric field. }}{71}{figure.caption.31}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces In the Poincaré any polarisation state is a point on the surface on the sphere, howerver if the state is partially polarized it would be a pointe inside the poincaré sphere whose distance from the center is $\sqrt {S_1^2+S_2^2 + S_3^2}$.}}{81}{figure.caption.33}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces The stereographic projection. A ray leaving the centre of projection $N$ and passing through a point $P$ of the sphere $S^2$ meets the plane $\mathbb {R}^2$ at a single point $Q$. Points near the contact point fall near the origin, and points near $N$ fly off towards infinity.}}{84}{figure.caption.36}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces The Poincaré sphere resting on the complex plane of the ratio $w$. Horizontal polarisation sits at the point of contact, $w=0$, vertical polarisation sits at the centre of projection and is sent to the point at infinity, and the equator, where the two amplitudes are equal, is mapped onto the unit circle $|w|=1$. The angles $2\alpha $ and $2\chi $ that locate a state $P$ on the sphere are twice the orientation and ellipticity angles of its ellipse.}}{86}{figure.caption.39}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces The flattened Poincaré sphere. Each point of the complex plane of $w$ carries the ellipse of the state it represents. The origin is horizontal polarisation, the real axis carries every linear state, the imaginary axis carries the ellipses aligned with the coordinate axes together with the two circular states, and every direction of escape to infinity leads to one and the same state, the vertical one.}}{88}{figure.caption.41}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces A quarter wave plate retarder is a retarder with $\delta = \pi /2$ and when it has got its fast axis oriented with the horizontal one it transforms the polarization in a very specific way. The $\pm 45$° diagonal states transform into circular polarization states, and the circular polarization states transform into $\pm 45$° diagonal states. }}{90}{figure.caption.43}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces A linear polariser with its polariser axis oriented parallel to the horizontal axis proyects all the incident states to horizontal ones, however the transmited intensity is reduced by the relative angle between the incident state $\mathinner {|{\alpha ;\chi }\rangle }$ and the polariser axis $\alpha _{pol}$ in this case $\alpha _{pol}=0$°. }}{94}{figure.caption.46}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces An initial state $\mathinner {|{\alpha ;\chi }\rangle }$ under the effect of a rotated retarder with retar $\delta $ and eigenstate $r$ is rotated an angle of $\delta $ arounde the $r$-axis to a final state $\mathinner {|{\alpha '.\chi '}\rangle }$. }}{99}{figure.caption.50}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Two plane waves with unitary number vector $\hat {k}_1,\hat {k}_2$ propagate and interferece producing a pattern of interference characterized by a vector $\vec {K}$ and an interfringe distance $\Lambda $.}}{116}{figure.caption.60}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Two plane sources of spherical waves interfere in a point $P$ located on the interference plane. The two sources are separated a distance $a$ an the distance from both surface to the interference plane is $D$.}}{117}{figure.caption.61}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Young interferometer illuminated by a spherical wave from a point source $\mathcal {S}$ placed off axis. The source to slit stage sets the amplitude and the phase reaching each slit $\mathcal {S}_1,\mathcal {S}_2$, and the slit to screen stage is the interference of two secondary spherical waves.}}{123}{figure.caption.62}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Method of images applied to the Fresnel biprism. Each half of the biprism produces a virtual point image of the source, $\mathcal {S}_1$ from the upper half and $\mathcal {S}_2$ from the lower half, separated by $a$ and located in the same transverse plane as $\mathcal {S}$. Beyond the biprism the two beams overlap only inside the shaded strip of width $W$ on the screen.}}{127}{figure.caption.63}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces General configuration of the Michelson interferometer. A source placed a distance $a$ from the beamsplitting cube illuminates it, and the beam is divided along two perpendicular arms. In arm 1 the light travels a total distance $d+\ell _1$ before striking mirror 1, tilted an angle $\theta $ away from the orientation that would send the beam straight back along itself; in arm 2 it travels a total distance $d+\ell _2$ before striking mirror 2, tilted an angle $\phi $ in the same sense. The two reflected beams return to the beamsplitter and recombine there, ready to interfere.}}{131}{figure.caption.64}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces On the boundary $\Sigma (V)$ the contribution of the field components $U(\vec {r})$ is shown; inside the region the total field is built from the contribution of all the points on the boundary. One may add infinitely many point Green charges of arbitrary propagation nature; the condition for the invariance of equation \eqref {eq:GreenHomogeneous} is that these image charges lie outside $\Sigma (V)$.}}{140}{figure.caption.65}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Representation of the Green's functions for point sources. Under these boundary conditions the Green's functions behave as point charges, one the mirror image of the other.}}{141}{figure.caption.66}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Representation of the Green's functions for non-point sources. Under these boundary conditions the Green's functions still behave as mirror images, but now with given volume and geometry; the only constraint on the emission of these sources is that, on the boundary $z=0$, the total field must vanish, as required by the assumed Dirichlet conditions.}}{142}{figure.caption.67}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Scheme of the confocal cardinal spheres, with radii equal to the propagation distance $z$ of the field.}}{146}{figure.caption.68}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Representation of $E(\vec {r},t)$ as a random variable.}}{154}{figure.caption.69}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Graphical representation of the narrowband coherence function. In black, the envelope $\tilde {\Gamma }(\vec {r},\tau )$ is shown, and in red the oscillations $e^{i2\pi \tilde {\nu }\tau }$. These oscillations are confined within something known as the coherence time $\tau _C$, which we shall see later.}}{159}{figure.caption.70}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Propagation of the electric field from a plane $Z=0$ to a plane $Z$, where each point of the wavefront carries its mean polarisation ellipse.}}{161}{figure.caption.71}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Propagation of the coherence function between two points $\vec {r},\vec {r}'$ on the initial plane to the coherence between two points $\vec {r}_1,\vec {r}_2$ on the observation plane.}}{163}{figure.caption.72}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Evolution of the realisations upon propagating the electric field.}}{164}{figure.caption.73}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces The mutual coherence propagated to the far field is the Fourier transform of the intensity distribution $\Gamma _0(\vec {S})$ of the source.}}{167}{figure.caption.74}%
